# Camera network discovery
SUBNET=192.168.138.0/24
# Comma-separated IPs on the camera subnet to exclude from scanning (e.g., router/NVR/gateway)
EXCLUDE_IPS=192.168.138.250,192.168.138.251
DISCOVER_INTERVAL=300
ONVIF_PORT=8080
RTSP_PORT=554

# Container macvlan IPs (used by docker-compose.example.yml)
GO2RTC_MACVLAN_IP=192.168.138.250
BRIDGE_MACVLAN_IP=192.168.138.251

# go2rtc integration & transcoding (vaapi | libx264 | copy)
GO2RTC_URL=http://zosi-go2rtc:1984
TRANSCODE_MODE=vaapi
VAAPI_DEVICE=/dev/dri/renderD128

# MQTT broker (Home Assistant Discovery & motion events)
MQTT_HOST=host.docker.internal
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=

# ONVIF motion watcher tuning
MOTION_POLL_INTERVAL=1.5
MOTION_OFF_DELAY=0.0

# In-memory RAM snapshot cache HTTP server (0 disables)
SNAPSHOT_SERVER_HOST=0.0.0.0
SNAPSHOT_SERVER_PORT=1985
SNAPSHOT_CACHE_TTL=10.0
# Idle background refresh interval in seconds when no client has requested snapshots recently (0 disables)
SNAPSHOT_IDLE_REFRESH_INTERVAL=300.0

# Container safety limits (docker-compose.example.yml)
GO2RTC_MEM_LIMIT=2g
GO2RTC_PIDS_LIMIT=256
